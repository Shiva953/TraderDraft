generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trader {
  id               String   @id @default(cuid())
  rank             Int
  name             String
  address          String?
  pnl              String
  winRate          Float?
  avatarUrl        String?
  xUrl             String?
  tokenMintAddress String?
  poolAddress      String?
  ticker           String?
  period           Period
  rarity           Rarity   @default(COMMON) // Add this new field
  rarityWeight     Float    @default(1.0)    // Add this for selection probability
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([address, period])
  @@index([period, rank])
  @@index([tokenMintAddress])
  @@index([poolAddress])
  @@index([ticker])
  @@index([rarity])     // Add index for rarity
  @@map("traders")
}

enum Rarity {
  LEGENDARY  // Top 3 (6%)
  EPIC      // Ranks 4-10 (14%) 
  RARE      // Ranks 11-25 (30%)
  COMMON    // Ranks 26-50 (50%)
}

model ScrapingMetadata {
  id           String   @id @default(cuid())
  period       Period
  totalTraders Int
  scrapedAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  @@unique([period, isActive])
  @@map("scraping_metadata")
}

model user {
  id                       Int      @id @default(autoincrement())
  userPrivyWalletAddress   String?
  packHoldings             Int?
  totalValueOfPackHoldings Decimal? @db.Decimal
  claimedPacks             Int?
  unclaimedPacks           Int?
  orders                   Order[]  @relation("UserOrders")
}

model Order {
  id                     String   @id @default(cuid())
  userPrivyWalletAddress String
  userId                 Int
  packsBought            Int
  totalValue             Decimal  @db.Decimal
  transactionHash        String?
  createdAt              DateTime @default(now())
  user                   user     @relation("UserOrders", fields: [userId], references: [id])

  @@index([userPrivyWalletAddress])
  @@index([createdAt])
  @@map("orders")
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
}
