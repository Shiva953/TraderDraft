generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int      @id @default(autoincrement())
  userPrivyWalletAddress   String   @unique
  packHoldings             Int?
  totalValueOfPackHoldings Decimal? @db.Decimal
  claimedPacks             Int?
  unclaimedPacks           Int?
  totalTournamentPoints    Decimal  @default(0) @db.Decimal
  portfolio                Decimal? @db.Decimal

  // X/Twitter Profile Data
  xUsername                String?  // Twitter/X handle without @
  xProfilePictureUrl       String?  // Twitter/X avatar URL
  xUrl                     String?  // Full Twitter/X profile URL

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  orders                   Order[]  @relation("UserOrders")
  competitionEntries       CompetitionEntry[]
  dailyScoreSnapshots      DailyScoreSnapshot[]
  revealedPacks            RevealedPack[] @relation("UserRevealedPacks")

  @@index([xUsername])
  @@map("users")
}

model Trader {
  id               String   @id @default(cuid())
  rank             Int
  name             String
  address          String?
  pnl              String
  winRate          Float?
  avatarUrl        String?
  xUrl             String?
  tokenMintAddress String?
  poolAddress      String?
  ticker           String?
  period           Period
  rarity           Rarity   @default(COMMON)
  rarityWeight     Float    @default(1.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Market data (cached, updated every 2 minutes by background job)
  tokenPrice              Float?   // Token price in USD
  priceChange24h          Float?   // Absolute 24h price change in USD
  priceChange24hPercent   Float?   // Percentage 24h price change
  marketCap               Float?   // Market capitalization in USD
  totalSupply             Float?   // Total token supply
  volume24h               Float?   // 24h trading volume
  liquidityUsd            Float?   // Liquidity in USD
  marketDataLastUpdated   DateTime? // Timestamp of last market data update

  @@unique([address, period])
  @@index([period, rank])
  @@index([tokenMintAddress])
  @@index([poolAddress])
  @@index([ticker])
  @@index([rarity])
  @@index([marketDataLastUpdated])
  @@map("traders")
}

model Competition {
  id          String            @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  status      CompetitionStatus @default(ACTIVE)
  tpPool      Decimal           @default(10000) @db.Decimal
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  entries            CompetitionEntry[]
  dailyScoreSnapshots DailyScoreSnapshot[]

  @@index([startDate, endDate])
  @@index([status])
  @@map("competitions")
}

// User participation in competitions
model CompetitionEntry {
  id                  String      @id @default(cuid())
  competitionId       String
  userId              Int
  joinedAt            DateTime    @default(now())
  
  // Final results (calculated after competition ends)
  windowScore         Decimal?    @db.Decimal
  tournamentPoints    Decimal?    @db.Decimal
  leaderboardPoints   Decimal?    @db.Decimal
  finalizedAt         DateTime?

  // Relations
  competition         Competition @relation(fields: [competitionId], references: [id])
  user                User        @relation(fields: [userId], references: [id])

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([userId])
  @@map("competition_entries")
}

// Daily aggregate score snapshots for users in competitions
// Stores ONE row per user per competition per day (much lighter than per-KOL storage)
// All KOL holdings are calculated from on-chain data, only the daily total score is stored
model DailyScoreSnapshot {
  id              String      @id @default(cuid())
  userId          Int
  competitionId   String
  snapshotDate    DateTime    // The date of this snapshot (normalized to 14:00 UTC)
  totalDailyScore Decimal     @db.Decimal // Sum of all KOL scores for this user on this day
  createdAt       DateTime    @default(now())

  // Relations
  user            User        @relation(fields: [userId], references: [id])
  competition     Competition @relation(fields: [competitionId], references: [id])

  @@unique([userId, competitionId, snapshotDate])
  @@index([userId, competitionId])
  @@index([competitionId])
  @@index([competitionId, snapshotDate])
  @@map("daily_score_snapshots")
}

model Order {
  id                     String   @id @default(cuid())
  userPrivyWalletAddress String
  userId                 Int
  packsBought            Int
  totalValue             Decimal  @db.Decimal
  transactionHash        String?
  createdAt              DateTime @default(now())

  user                   User     @relation("UserOrders", fields: [userId], references: [id])

  @@index([userPrivyWalletAddress])
  @@index([createdAt])
  @@map("orders")
}

// Off-chain storage for revealed pack contents
// Replaces on-chain Pack PDAs to reduce transaction overhead
model RevealedPack {
  id                     String   @id @default(cuid())
  packId                 String   @unique
  userPrivyWalletAddress String
  userId                 Int

  // 4 KOL token mint addresses in this pack
  kolMintA               String
  kolMintB               String
  kolMintC               String
  kolMintD               String

  // KOL metadata (denormalized for quick access)
  kolNameA               String
  kolNameB               String
  kolNameC               String
  kolNameD               String

  kolTickerA             String
  kolTickerB             String
  kolTickerC             String
  kolTickerD             String

  kolRarityA             Rarity
  kolRarityB             Rarity
  kolRarityC             Rarity
  kolRarityD             Rarity

  revealedAt             DateTime @default(now())
  claimedAt              DateTime?

  user                   User     @relation("UserRevealedPacks", fields: [userId], references: [id])

  @@index([userId])
  @@index([userPrivyWalletAddress])
  @@index([revealedAt])
  @@index([claimedAt])
  @@index([userId, claimedAt])
  @@map("revealed_packs")
}

model ScrapingMetadata {
  id           String   @id @default(cuid())
  period       Period
  totalTraders Int
  scrapedAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  @@unique([period, isActive])
  @@map("scraping_metadata")
}

// App phase tracking for bootstrap and competition cycles
model AppPhase {
  id              String   @id @default(cuid())
  currentPhase    String   // PACK_SALE | PACK_REVEAL | COMPETITION_LOOP
  phaseStartedAt  DateTime
  packSaleEndsAt  DateTime?
  revealEndsAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([currentPhase])
  @@index([createdAt])
  @@map("app_phases")
}


enum CompetitionStatus {
  ACTIVE
  ENDED
  FINALIZED
}

enum Rarity {
  LEGENDARY
  EPIC
  RARE
  COMMON
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
}