# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
NEXT_PRIVY_CLIENT_APP_ID=your_privy_client_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Google OAuth (if using)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Solana Admin Wallet
ADMIN_KEYPAIR=[your,admin,keypair,array,here]

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Application URL (automatically set by Vercel in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (optional, for securing cron endpoints)
NEXT_PUBLIC_CRON_SECRET=your_cron_secret_here

# Test Mode (enables test controller UI - auto-enabled in development)
NEXT_PUBLIC_ENABLE_TEST_MODE=true
